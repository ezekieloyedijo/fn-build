generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum ProjectStatus {
  ONGOING
  COMPLETED
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role     @default(ADMIN)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Project {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  category        String
  location        String
  description     String        @db.Text
  story           String?       @db.Text
  challenges      String?       @db.Text
  solutions       String?       @db.Text
  results         String?       @db.Text
  clientName      String?
  clientCompany   String?
  status          ProjectStatus @default(ONGOING)
  completionDate  DateTime?
  coverImage      String
  featured        Boolean       @default(false)
  order           Int           @default(0)
  images          ProjectImage[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([category])
  @@index([status])
}

model ProjectImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  order     Int      @default(0)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  image       String
  icon        String   @default("HardHat")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id         String   @id @default(cuid())
  clientName String
  company    String?
  message    String   @db.Text
  image      String?
  rating     Int      @default(5)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  category  String   @default("General")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model Enquiry {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String?
  projectType String?
  message     String        @db.Text
  status      EnquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())
}
