# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/fnbuild?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Vercel Blob (image uploads). Leave unset for local dev to fall back to
# writing files under public/uploads. Vercel injects this automatically
# once a Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=""

# Admin bootstrap (used by prisma/seed.ts to create the first admin user)
ADMIN_EMAIL="admin@fnbuild.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="FNBUILD Admin"

# SMTP (contact form notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user@gmail.com"
SMTP_PASSWORD="your-smtp-app-password"
CONTACT_TO_EMAIL="info@fnbuild.com.ng"
CONTACT_FROM_EMAIL="FNBUILD & Construction <no-reply@fnbuild.com.ng>"

# Public site info
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# WhatsApp number in international format, no "+" or spaces (used to build wa.me links)
NEXT_PUBLIC_WHATSAPP_NUMBER="2348012345678"
NEXT_PUBLIC_PHONE_NUMBER="+234 801 234 5678"
